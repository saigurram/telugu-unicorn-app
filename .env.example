# Anthropic Claude (server-only, never exposed to the client)
ANTHROPIC_API_KEY=

# ElevenLabs — primary TTS + STT
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Must stay eleven_v3 — eleven_multilingual_v2 does not support Telugu.
# Note: eleven_v3 does not support the voice_settings.speed field, so the
# app cannot slow its pace down via the API on this model (see README).
ELEVENLABS_MODEL_ID=eleven_v3

# Sarvam AI — fallback TTS (Bulbul) + optional STT (Saarika)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saarika:v2

# Provider selection — swap vendors without a code change
TTS_PRIMARY_PROVIDER=elevenlabs
STT_PRIMARY_PROVIDER=elevenlabs

# Timeouts (ms) for outbound vendor calls
TTS_TIMEOUT_MS=8000
CLAUDE_TIMEOUT_MS=15000
STT_TIMEOUT_MS=10000
